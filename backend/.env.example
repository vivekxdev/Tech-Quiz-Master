# Server
PORT=5000
NODE_ENV=development

# Database (MongoDB connection string)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/TechQuiz

# Clerk (Dashboard -> API Keys)
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret

# Email that receives the "admin" role (must match a Clerk login email)
ADMIN_EMAIL=your_email@domain.com
# Replace your_email@domain.com with your actual Clerk login email

# CORS: exact origins allowed to call this API (never a wildcard "*")
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
# Optional: extra comma-separated origins for additional deployments
# e.g. CORS_EXTRA_ORIGINS=https://old-alias.vercel.app,https://other.vercel.app
CORS_EXTRA_ORIGINS=

# --- Security / traffic limits (all optional, defaults shown) ---------------
# Reverse-proxy hops to trust for X-Forwarded-For. Needed behind Render so
# rate limiting sees the visitor instead of the proxy. Use a hop count (1) or
# a comma-separated list of proxy IPs/CIDRs — never "true" (it would let any
# client spoof its own address and get a fresh rate-limit bucket).
# TRUST_PROXY=1

# Fixed window shared by every rate limiter (milliseconds)
# RATE_LIMIT_WINDOW_MS=900000
# Requests allowed per window, per client IP
# RATE_LIMIT_GENERAL_MAX=600        # every /api request
# RATE_LIMIT_SUBMIT_MAX=120         # POST /api/results/create
# RATE_LIMIT_ADMIN_MAX=120          # admin upload / stats / delete
# RATE_LIMIT_WEBHOOK_MAX=120        # POST /api/users/webhook/clerk

# Request body caps (413 above the limit). Must be a positive number with a
# unit (kb, mb, gb): an unparsable value stops the server at startup instead
# of being silently ignored (which would disable the cap).
# JSON_BODY_LIMIT=512kb             # express.json() for API payloads
# URLENCODED_BODY_LIMIT=64kb        # express.urlencoded() (no endpoint reads form fields)
# WEBHOOK_BODY_LIMIT=100kb          # express.raw() before SVIX verification
